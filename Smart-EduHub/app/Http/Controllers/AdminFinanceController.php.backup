ds', 'student_card_transactions.card_id', '=', 'student_cards.id')            ->join('students', 'student_cards.student_id', '=', 'students.id');        if ($studentId) {            $perStudentSummaryQuery->where('students.id', $studentId);}        $perStudentSummary = $perStudentSummaryQuery->selectRaw('students.nama_lengkap, students.nis_siswa, student_cards.card_number, student_cards.balance as current_balance')            ->selectRaw("SUM(CASE WHEN student_card_transactions.type = 'topup' THEN student_card_transactions.amount ELSE 0 END) as total_topup")            ->selectRaw("SUM(CASE WHEN student_card_transactions.type = 'payment' THEN student_card_transactions.amount ELSE 0 END) as total_payment")            ->selectRaw("SUM(CASE WHEN student_card_transactions.type = 'transfer' THEN student_card_transactions.amount ELSE 0 END) as total_transfer")            ->selectRaw("SUM(CASE WHEN student_card_transactions.type = 'withdraw' THEN student_card_transactions.amount ELSE 0 END) as total_withdraw")            ->selectRaw('COUNT(student_card_transactions.id) as total_trx')            ->groupBy('students.nama_lengkap', 'students.nis_siswa', 'student_cards.card_number', 'student_cards.balance')            ->orderBy('students.nama_lengkap')            ->get();        $transactions = (clone $query)->with(['card.student', 'performedBy'])->latest()->get();        $grandTotal = [            'topup'    => (float) optional($summary->get('topup'))->total,            'payment'  => (float) optional($summary->get('payment'))->total,            'transfer' => (float) optional($summary->get('transfer'))->total,            'withdraw' => (float) optional($summary->get('withdraw'))->total,        ];        $filteredStudent = $studentId ? Student::find($studentId) : null;public function exportStudentExcel(Request $request, StudentCard $card)    {        $this->authorizeFinance('canViewFinanceCards');        $from = $request->input('from');        $to   = $request->input('to');     