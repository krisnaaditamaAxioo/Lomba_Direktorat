<?phpnamespace App\Http\Controllers;use App\Exports\FinanceReportExport;use App\Exports\FinanceStudentExport;use App\Models\Student;use App\Models\StudentCard;use App\Models\StudentCardRequest;use App\Models\Setting;use App\Models\StudentCardTransaction;use App\Models\Angkatan;use Barryvdh\DomPDF\Facade\Pdf;use Illuminate\Http\Request;use Illuminate\Support\Facades\Auth;use Illuminate\Support\Facades\DB;use Illuminate\Validation\ValidationException;use Maatwebsite\Excel\Facades\Excel;class AdminFinanceController extends Controller{public function index()    {        $user = auth()->user();        if ($user->canAccessFinanceDashboard()) {            return redirect()->route('admin.finance.dashboard');}        if ($user->canViewFinancePaymentHistory() && $user->isBums()) {            return redirect()->route('admin.finance.payments.history');}        return redirect()->route('admin.finance.cards');}public function transactionSearch()    {        $this->authorizeFinance('canTopupFinance');        return view('admin.finance.transaction-search');}public function searchCardByNis(Request $request)    {        try {            $this->authorizeFinance('canTopupFinance');            $nis = $request->input('nis');            if (!$nis) {                return response()->json([                    'success' => false,                    'message' => 'NIS harus diisi'                ]);}            $student = Student::where('nis_siswa', $nis)->orWhere('nisn', $nis)->first();            if (!$student) {                return response()->json([                    'success' => false,                    'message' => 'Siswa dengan NIS ' . $nis . ' tidak ditemukan'                ]);}            // Support multiple cards per student            $cards = StudentCard::where('student_id', $student->id)->get();            if ($cards->isEmpty()) {                return response()->json([                    'success' => false,                    'message' => 'Kartu siswa belum dibuat. Silakan hubungi admin.'                ]);}            return response()->json([                'success' => true,                'cards' => $cards->map(function($card) {                    return [                        'id' => $card->id,                        'card_number' => $card->card_number,                        'balance' => $card->balance,                        'status' => $card->status,                    ];}),                'student' => [                    'id' => $student->id,                    'nama_lengkap' => $student->nama_lengkap,                    'angkatan' => $student->angkatan,                ]            ]);} catch (\Exception $e) {            return response()->json([                'success' => false,                'message' => 'Terjadi kesalahan: ' . $e->getMessage()            ], 500);}}public function requests()    {        $this->authorizeFinance('canManageFinanceRequests');        $requests = StudentCardRequest::with('student')->latest()->get();        return view('admin.finance.requests', compact('requests'));}public function approveRequest(Request $request, $cardRequestId)    {        $this->authorizeFinance('canManageFinanceRequests');        $cardRequest = DB::table('student_card_requests')->where('id', $cardRequestId)->first();        if (!$cardRequest) {            return back()->with('error', 'Pengajuan tidak ditemukan!');}        if (!$cardRequest->student_id) {            return back()->with('error', 'Data pengajuan tidak valid: student_id tidak ditemukan di database!');}        $student = Student::find($cardRequest->student_id);        if (!$student) {            return back()->with('error', 'Siswa tidak ditemukan!');}        $cardNumber = $this->generateCardNumber();        $card = StudentCard::create([            'student_id' => $cardRequest->student_id,            'card_number' => $cardNumber,            'balance' => 0,            'status' => 'active',        ]);        DB::table('student_card_requests')->where('id', $cardRequestId)->update([            'status' => 'approved',            'admin_note' => $request->admin_note,            'approved_by' => Auth::id(),            'approved_at' => now(),        ]);        return back()->with('success', 'Pengajuan kartu berhasil disetujui! Kartu telah dibuat dengan nomor: ' . $cardNumber);}public function rejectRequest(Request $request, $cardRequestId)    {        $this->authorizeFinance('canManageFinanceRequests');        DB::table('student_card_requests')->where('id', $cardRequestId)->update([            'status' => 'rejected',            'admin_note' => $request->admin_note,        ]);        return back()->with('success', 'Pengajuan kartu berhasil ditolak!');}public function dashboard(Request $request)    {        $this->authorizeFinance('canAccessFinanceDashboard');        $startDate = $request->input('start_date', now()->startOfMonth()->toDateString());        $endDate = $request->input('end_date', now()->toDateString());        $transactionsQuery = StudentCardTransaction::with(['card.student', 'performedBy'])            ->whereBetween(DB::raw('DATE(created_at)'), [$startDate, $endDate]);        $totalTopup = (clone $transactionsQuery)->where('type', 'topup')->sum('amount');        $totalPayment = (clone $transactionsQuery)->where('type', 'payment')->sum('amount');        $totalTransfer = (clone $transactionsQuery)->where('type', 'transfer')->sum('amount');        $transactionCount = (clone $transactionsQuery)->count();        $recentTransactions = (clone $transactionsQuery)            ->latest()            ->limit(10)            ->get();        $dailyRecap = StudentCardTransaction::query()            ->selectRaw('DATE(created_at) as transaction_date')            ->selectRaw("SUM(CASE WHEN type = 'topup' THEN amount ELSE 0 END) as total_topup")            ->selectRaw("SUM(CASE WHEN type = 'payment' THEN amount ELSE 0 END) as total_payment")            ->selectRaw('COUNT(*) as total_transactions')            ->whereBetween(DB::raw('DATE(created_at)'), [$startDate, $endDate])            ->groupBy(DB::raw('DATE(created_at)'))            ->orderBy('transaction_date', 'desc')            ->limit(7)            ->get();        $activeCards = StudentCard::where('status', 'active')->count();        $pendingRequests = StudentCardRequest::where('status', 'pending')->count();        return view('admin.finance.dashboard', compact(            'totalTopup',            'totalPayment',            'totalTransfer',            'transactionCount',            'recentTransactions',            'dailyRecap',            'activeCards',            'pendingRequests',            'startDate',            'endDate'        ));}public function rekap(Request $request)    {        $this->authorizeFinance('canAccessFinanceRekap');        $from = $request->input('from', now()->startOfMonth()->toDateString());        $to = $request->input('to', now()->toDateString());        $studentId = $request->input('student_id');        $query = StudentCardTransaction::with(['card.student', 'performedBy'])            ->whereBetween(DB::raw('DATE(created_at)'), [$from, $to]);        if ($studentId) {            $query->whereHas('card', function ($cardQuery) use ($studentId) {                $cardQuery->where('student_id', $studentId);});}        $summary = (clone $query)            ->selectRaw('type, SUM(amount) as total, COUNT(*) as count')            ->groupBy('type')            ->get()            ->keyBy('type');        $dailySummary = (clone $query)            ->selectRaw('DATE(created_at) as transaction_date')            ->selectRaw("SUM(CASE WHEN type = 'topup' THEN amount ELSE 0 END) as total_topup")            ->selectRaw("SUM(CASE WHEN type = 'payment' THEN amount ELSE 0 END) as total_payment")            ->selectRaw("SUM(CASE WHEN type = 'transfer' THEN amount ELSE 0 END) as total_transfer")            ->selectRaw("SUM(CASE WHEN type = 'withdraw' THEN amount ELSE 0 END) as total_withdraw")            ->selectRaw('COUNT(*) as total_transactions')            ->groupBy(DB::raw('DATE(created_at)'))            ->orderBy('transaction_date', 'desc')            ->get();        $paymentTransactions = (clone $query)            ->where('type', 'payment')            ->latest()            ->limit(20)            ->get();        $grandTotal = [            'topup' => (float) optional($summary->get('topup'))->total,            'payment' => (float) optional($summary->get('payment'))->total,            'transfer' => (float) optional($summary->get('transfer'))->total,            'withdraw' => (float) optional($summary->get('withdraw'))->total,        ];        $students = Student::has('cards')->orderBy('nama_lengkap')->get(['id', 'nama_lengkap', 'nis_siswa']);        return view('admin.finance.rekap', compact('summary', 'dailySummary', 'paymentTransactions', 'grandTotal', 'from', 'to', 'students', 'studentId'));}public function fastPayment()    {        $this->authorizeFinance('canProcessFinancePayment');        $fastPaymentAmount = Setting::get('fast_payment_amount');        if (!$fastPaymentAmount) {            $fastPaymentAmount = 5000;            Setting::set('fast_payment_amount', $fastPaymentAmount);}        return view('admin.finance.fast-payment', compact('fastPaymentAmount'));}public function fastPaymentSearch(Request $request)    {        $this->authorizeFinance('canProcessFinancePayment');        $query = $request->input('query');        if (!$query) {            return response()->json(['success' => false, 'message' => 'Query tidak boleh kosong.']);}        // Search by NIS, card number, or QR code data        $student = Student::where('nis_siswa', $query)            ->orWhere('nisn', $query)            ->first();        if (!$student) {            // Check if query is a card number            $card = StudentCard::where('card_number', $query)->first();            if ($card) {                $student = $card->student;}}        if (!$student) {            return response()->json(['success' => false, 'message' => 'Siswa tidak ditemukan.']);}        $cards = $student->cards()->where('status', 'active')->get();        return response()->json([            'success' => true,            'student' => [                'id' => $student->id,                'nama_lengkap' => $student->nama_lengkap,                'nis_siswa' => $student->nis_siswa,            ],            'cards' => $cards        ]);}public function fastPaymentProcess(Request $request)    {        $user = $this->authorizeFinance('canProcessFinancePayment');        $validated = $request->validate([            'card_id' => 'required|exists:student_cards,id',            'pin' => 'required|string',        ]);        $card = StudentCard::findOrFail($validated['card_id']);        $fastPaymentAmount = (int) Setting::get('fast_payment_amount', 5000);        if ($card->status !== 'active') {            $message = 'Kartu siswa tidak aktif untuk pembayaran.';            return response()->json(['success' => false, 'message' => $message]);}        // Validate PIN        $card->load('student');        $isPinValid = false;        if ($card->pin && $card->pin === $validated['pin']) {            $isPinValid = true;} elseif ($card->student && $card->student->pin && $card->student->pin === $validated['pin']) {            $isPinValid = true;}        if (!$isPinValid) {            $message = 'PIN salah. Silakan coba lagi.';            return response()->json(['success' => false, 'message' => $message], 422);}        $transaction = null;        try {            DB::transaction(function () use ($card, $fastPaymentAmount, $user, &$transaction) {                $card->refresh();                if ($card->balance < $fastPaymentAmount) {                    throw ValidationException::withMessages([                        'card' => 'Saldo tidak cukup pada kartu siswa.'                    ]);}                $balanceBefore = $card->balance;                $balanceAfter = $balanceBefore - $fastPaymentAmount;                $card->update(['balance' => $balanceAfter]);                $transaction = StudentCardTransaction::create([                    'card_id' => $card->id,                    'type' => 'payment',                    'amount' => $fastPaymentAmount,                    'balance_before' => $balanceBefore,                    'balance_after' => $balanceAfter,                    'reference_number' => $this->generateReferenceNumber('FPAY'),                    'description' => 'Pembayaran Cepat (Parkir)',                    'merchant_name' => 'Parkir',                    'performed_by' => $user->id,                ]);});            return response()->json([                'success' => true,                'message' => 'Pembayaran cepat berhasil!',                'transaction_id' => $transaction->id            ]);} catch (ValidationException $e) {            $message = $e->errors()['card'][0] ?? 'Pembayaran gagal.';            return response()->json(['success' => false, 'message' => $message], 422);} catch (\Exception $e) {            $message = 'Terjadi kesalahan: ' . $e->getMessage();            return response()->json(['success' => false, 'message' => $message], 500);}}public function payment(Request $request, StudentCard $card)    {        $user = $this->authorizeFinance('canProcessFinancePayment');        $validated = $request->validate([            'amount' => 'required|numeric|min:1000',            'description' => 'nullable|string|max:255',            'merchant_name' => 'nullable|string|max:255',            'pin' => 'required|string',        ]);        if ($card->status !== 'active') {            $message = 'Kartu siswa tidak aktif untuk pembayaran.';            return $request->expectsJson()                ? response()->json(['success' => false, 'message' => $message])                : back()->with('error', $message);}        // Validate PIN        $card->load('student');        $isPinValid = false;                // Check StudentCard's pin first        if ($card->pin && $card->pin === $validated['pin']) {            $isPinValid = true;}         // If not, check Student's pin        elseif ($card->student && $card->student->pin && $card->student->pin === $validated['pin']) {            $isPinValid = true;}        if (!$isPinValid) {            $message = 'PIN salah. Silakan coba lagi.';            return $request->expectsJson()                ? response()->json(['success' => false, 'message' => $message], 422)                : back()->with('error', $message);}        $transaction = null;        try {            DB::transaction(function () use ($card, $validated, $user, &$transaction) {                $card->refresh();                if ($card->balance < $validated['amount']) {                    throw ValidationException::withMessages([                        'amount' => 'Saldo tidak cukup pada kartu siswa.',                    ]);}                $balanceBefore = $card->balance;                $balanceAfter = $balanceBefore - $validated['amount'];                $card->update(['balance' => $balanceAfter]);                $description = trim(collect([                    'Pembayaran via ' . strtoupper($user->role),                    $validated['merchant_name'] ?? null,                    $validated['description'] ?? null,                ])->filter()->implode(' - '));                $transaction = StudentCardTransaction::create([                    'card_id' => $card->id,                    'type' => 'payment',                    'amount' => $validated['amount'],                    'balance_before' => $balanceBefore,                    'balance_after' => $balanceAfter,                    'reference_number' => $this->generateReferenceNumber('PAY'),                    'description' => $description,                    'performed_by' => $user->id,                ]);});            $message = 'Pembayaran berhasil diproses.';            return $request->expectsJson()                ? response()->json(['success' => true, 'message' => $message, 'transaction_id' => $transaction->id])                : redirect()->back()->with('success', $message);} catch (ValidationException $e) {            $message = $e->errors()['amount'][0] ?? $e->errors()['pin'][0] ?? 'Pembayaran gagal.';            return $request->expectsJson()                ? response()->json(['success' => false, 'message' => $message], 422)                : back()->with('error', $message);} catch (\Exception $e) {            $message = 'Terjadi kesalahan: ' . $e->getMessage();            return $request->expectsJson()                ? response()->json(['success' => false, 'message' => $message], 500)                : back()->with('error', $message);}}public function cards(Request $request)    {        $this->authorizeFinance('canViewFinanceCards');        $query = StudentCard::with('student.angkatanModel')->latest();        $nama = $request->input('nama');        $angkatan = $request->input('angkatan');        if ($nama) {            $query->whereHas('student', function($q) use ($nama) {                $q->where('nama_lengkap', 'LIKE', '%' . $nama . '%');});}        if ($angkatan) {            $query->whereHas('student.angkatanModel', function($q) use ($angkatan) {                $q->where('code', $angkatan);});}        $cards = $query->paginate(20)->appends($request->only('nama', 'angkatan'));        $angkatanList = Angkatan::orderBy('code')->pluck('code')->filter();        return view('admin.finance.cards', compact('cards', 'angkatanList', 'nama', 'angkatan'));}public function showCard(StudentCard $card)    {        $user = $this->authorizeFinance('canViewFinanceCards');        $card->load('student');        $transactions = $card->transactions()            ->with(['performedBy', 'relatedCard.student'])            ->when($user->isBums(), fn ($query) => $query->where('type', 'payment'))            ->latest()            ->get();        return view('admin.finance.card-detail', compact('card', 'transactions'));}public function showReceipt(StudentCardTransaction $transaction)    {        $this->authorizeFinance('canViewFinanceCards');        $transaction->load(['card.student', 'performedBy', 'relatedCard.student']);        return view('admin.finance.receipt', compact('transaction'));}public function topupCard(Request $request, StudentCard $card)    {        $user = $this->authorizeFinance('canTopupFinance');        $validated = $request->validate([            'amount' => 'required|numeric|min:1000',            'description' => 'nullable|string|max:255',        ]);        if ($card->status !== 'active') {            $message = 'Kartu siswa tidak aktif untuk top up.';            return $request->expectsJson()                ? response()->json(['success' => false, 'message' => $message])                : back()->with('error', $message);}        $transaction = null;        try {            DB::transaction(function () use ($card, $validated, $user, &$transaction) {                $card->refresh();                $balanceBefore = $card->balance;                $balanceAfter = $balanceBefore + $validated['amount'];                $card->update(['balance' => $balanceAfter]);                $transaction = StudentCardTransaction::create([                    'card_id' => $card->id,                    'type' => 'topup',                    'amount' => $validated['amount'],                    'balance_before' => $balanceBefore,                    'balance_after' => $balanceAfter,                    'reference_number' => $this->generateReferenceNumber('TPU'),                    'description' => $validated['description'] ?: ($user->isTeller() ? 'Top up oleh teller' : 'Top up oleh admin'),                    'performed_by' => $user->id,                ]);});            $message = 'Top up saldo berhasil diproses.';            return $request->expectsJson()                ? response()->json(['success' => true, 'message' => $message, 'transaction_id' => $transaction->id])                : redirect()->back()->with('success', $message);} catch (\Exception $e) {            $message = 'Terjadi kesalahan: ' . $e->getMessage();            return $request->expectsJson()                ? response()->json(['success' => false, 'message' => $message], 500)                : back()->with('error', $message);}}public function withdrawCard(Request $request, StudentCard $card)    {        $user = $this->authorizeFinance('canTopupFinance');        $validated = $request->validate([            'amount' => 'required|numeric|min:1000',            'description' => 'nullable|string|max:255',            'pin' => 'required|string',        ]);        if ($card->status !== 'active') {            $message = 'Kartu siswa tidak aktif untuk tarik tunai.';            return $request->expectsJson()                ? response()->json(['success' => false, 'message' => $message])                : back()->with('error', $message);}        // Validate PIN        $card->load('student');        $isPinValid = false;                // Check StudentCard's pin first        if ($card->pin && $card->pin === $validated['pin']) {            $isPinValid = true;}         // If not, check Student's pin        elseif ($card->student && $card->student->pin && $card->student->pin === $validated['pin']) {            $isPinValid = true;}        if (!$isPinValid) {            $message = 'PIN salah. Silakan coba lagi.';            return $request->expectsJson()                ? response()->json(['success' => false, 'message' => $message], 422)                : back()->with('error', $message);}        if ($card->balance < $validated['amount']) {            $message = 'Saldo kartu tidak mencukupi untuk tarik tunai.';            return $request->expectsJson()                ? response()->json(['success' => false, 'message' => $message], 422)                : back()->with('error', $message);}        $transaction = null;        try {            DB::transaction(function () use ($card, $validated, $user, &$transaction) {                $card->refresh();                $balanceBefore = $card->balance;                $balanceAfter = $balanceBefore - $validated['amount'];                $card->update(['balance' => $balanceAfter]);                $transaction = StudentCardTransaction::create([                    'card_id' => $card->id,                    'type' => 'withdraw',                    'amount' => $validated['amount'],                    'balance_before' => $balanceBefore,                    'balance_after' => $balanceAfter,                    'reference_number' => $this->generateReferenceNumber('WDL'),                    'description' => $validated['description'] ?: ($user->isTeller() ? 'Tarik tunai oleh teller' : 'Tarik tunai oleh admin'),                    'performed_by' => $user->id,                ]);});            $message = 'Tarik tunai berhasil diproses.';            return $request->expectsJson()                ? response()->json(['success' => true, 'message' => $message, 'transaction_id' => $transaction->id])                : redirect()->back()->with('success', $message);} catch (\Exception $e) {            $message = 'Terjadi kesalahan: ' . $e->getMessage();            return $request->expectsJson()                ? response()->json(['success' => false, 'message' => $message], 500)                : back()->with('error', $message);}}public function updateCardStatus(Request $request, StudentCard $card)    {        $this->authorizeFinance('canUpdateFinanceCardStatus');        $validated = $request->validate([            'status' => 'required|in:active,frozen,inactive',        ]);        $card->update(['status' => $validated['status']]);        return back()->with('success', 'Status kartu berhasil diupdate!');}private function generateCardNumber()    {        $year = date('Y');        $random = str_pad(mt_rand(0, 999999), 6, '0', STR_PAD_LEFT);        $cardNumber = $year . $random;        while (StudentCard::where('card_number', $cardNumber)->exists()) {            $random = str_pad(mt_rand(0, 999999), 6, '0', STR_PAD_LEFT);            $cardNumber = $year . $random;}        return $cardNumber;}public function transactions(Request $request)    {        $this->authorizeFinance('canManageFinanceTransactions');        $transactions = StudentCardTransaction::with(['card.student', 'performedBy', 'relatedCard.student'])            ->when($request->filled('student_name'), function ($query) use ($request) {                $query->whereHas('card.student', function ($studentQuery) use ($request) {                    $studentQuery->where('nama_lengkap', 'like', '%' . $request->student_name . '%');});})            ->when($request->filled('card_number'), function ($query) use ($request) {                $query->whereHas('card', fn ($cardQuery) => $cardQuery->where('card_number', 'like', '%' . $request->card_number . '%'));})            ->when($request->filled('type'), fn ($query) => $query->where('type', $request->type))            ->when($request->filled('date'), fn ($query) => $query->whereDate('created_at', $request->date))            ->latest()            ->paginate(20)            ->withQueryString();        return view('admin.finance.transactions.index', compact('transactions'));}public function editTransaction(StudentCardTransaction $transaction)    {        $this->authorizeFinance('canManageFinanceTransactions');        $transaction->load(['card.student', 'performedBy', 'relatedCard.student']);        return view('admin.finance.transactions.edit', compact('transaction'));}public function updateTransaction(Request $request, StudentCardTransaction $transaction)    {        $this->authorizeFinance('canManageFinanceTransactions');        $rules = [            'description' => 'nullable|string|max:255',        ];        if (! in_array($transaction->type, ['transfer'], true)) {            $rules['amount'] = 'required|numeric|min:1000';}        $validated = $request->validate($rules);        if (array_key_exists('amount', $validated) && $validated['amount'] != $transaction->amount) {            if (! $this->isLatestTransaction($transaction)) {                return back()->with('error', 'Hanya transaksi terakhir dapat diubah jumlahnya.');}            $newAmount = $validated['amount'];            if ($transaction->type === 'topup') {                $balanceAfter = $transaction->balance_before + $newAmount;                $transaction->card->balance += ($newAmount - $transaction->amount);} elseif ($transaction->type === 'payment' || $transaction->type === 'withdraw') {                $balanceAfter = $transaction->balance_before - $newAmount;                $transaction->card->balance += ($transaction->amount - $newAmount);} else {                return back()->with('error', 'Jenis transaksi ini tidak dapat diubah jumlahnya.');}            $transaction->card->save();            $transaction->amount = $newAmount;            $transaction->balance_after = $balanceAfter;}        $transaction->description = $validated['description'] ?? $transaction->description;        $transaction->save();        return redirect()->route('admin.finance.transactions.index')->with('success', 'Transaksi berhasil diperbarui.');}public function destroyTransaction(StudentCardTransaction $transaction)    {        $this->authorizeFinance('canManageFinanceTransactions');        if (! $this->isLatestTransaction($transaction)) {            return back()->with('error', 'Hanya transaksi terakhir pada kartu yang dapat dihapus.');}        if ($transaction->type === 'transfer') {            return back()->with('error', 'Transaksi transfer tidak dapat dihapus melalui halaman ini.');}        DB::transaction(function () use ($transaction) {            if ($transaction->type === 'topup') {                $transaction->card->balance -= $transaction->amount;}            if ($transaction->type === 'payment' || $transaction->type === 'withdraw') {                $transaction->card->balance += $transaction->amount;}            $transaction->card->save();            $transaction->delete();});        return redirect()->route('admin.finance.transactions.index')->with('success', 'Transaksi berhasil dihapus.');}private function isLatestTransaction(StudentCardTransaction $transaction): bool    {        $latest = $transaction->card->transactions()->latest('id')->first();        return $latest && $latest->id === $transaction->id;}public function paymentHistory(Request $request)    {        $user = $this->authorizeFinance('canViewFinancePaymentHistory');        $transactions = StudentCardTransaction::with(['card.student', 'performedBy'])            ->where('type', 'payment')            ->when($request->filled('student_name'), function ($query) use ($request) {                $query->whereHas('card.student', function ($studentQuery) use ($request) {                    $studentQuery->where('nama_lengkap', 'like', '%' . $request->student_name . '%');});})            ->when($request->filled('date'), fn ($query) => $query->whereDate('created_at', $request->date))            ->latest();        if ($user->isBums()) {            $transactions->whereNotNull('performed_by');}        $transactions = $transactions->paginate(20)->withQueryString();        return view('admin.finance.payment-history', compact('transactions'));}private function generateReferenceNumber(string $prefix): string    {        do {            $referenceNumber = $prefix . now()->format('YmdHis') . random_int(100, 999);} while (StudentCardTransaction::where('reference_number', $referenceNumber)->exists());        return $referenceNumber;}    // =========================================    // EXPORT METHODS    // =========================================    /**     * Export laporan keuangan SEMUA siswa ke Excel     */    public function exportRekapExcel(Request $request)    {        $this->authorizeFinance('canAccessFinanceRekap');        $from = $request->input('from', now()->startOfMonth()->toDateString());        $to   = $request->input('to', now()->toDateString());        $type = $request->input('type', 'all');     