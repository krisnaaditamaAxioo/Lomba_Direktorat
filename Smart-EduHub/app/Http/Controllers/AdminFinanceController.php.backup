By(DB::raw('DATE(created_at)'))            ->orderBy('transaction_date', 'asc')            ->get();        $perStudentSummaryQuery = StudentCardTransaction::with(['card.student'])            ->whereBetween(DB::raw('DATE(student_card_transactions.created_at)'), [$from, $to])            ->join('student_cards', 'student_card_transactions.card_id', '=', 'student_cards.id')            ->join('students', 'student_cards.student_id', '=', 'students.id');        if ($studentId) {            $perStudentSummaryQuery->where('students.id', $studentId);        }        $perStudentSummary = $perStudentSummaryQuery->selectRaw('students.nama_lengkap, students.nis_siswa, student_cards.card_number, student_cards.balance as current_balance')            ->selectRaw("SUM(CASE WHEN student_card_transactions.type = 'topup' THEN student_card_transactions.amount ELSE 0 END) as total_topup")            ->selectRaw("SUM(CASE WHEN student_card_transactions.type = 'payment' THEN student_card_transactions.amount ELSE 0 END) as total_payment")            ->selectRaw("SUM(CASE WHEN student_card_transactions.type = 'transfer' THEN student_card_transactions.amount ELSE 0 END) as total_transfer")            ->selectRaw('COUNT(student_card_transactions.id) as total_trx')            ->groupBy('students.nama_lengkap', 'students.nis_siswa', 'student_cards.card_number', 'student_cards.balance')            ->orderBy('students.nama_lengkap')            ->get();        $transactions = (clone $query)->with(['card.student', 'performedBy'])->latest()->get();        $grandTotal = [            'topup'    => (float) optional($summary->get('topup'))->total,            'payment'  => (float) optional($summary->get('payment'))->total,            'transfer' => (float) optional($summary->get('transfer'))->total,        ];        $filteredStudent = $studentId ? Student::find($studentId) : null;        $pdf = Pdf::loadView('admin.finance.pdf.report-all', compact(            'summary', 'dailySummary', 'perStudentSummary', 'transactions', 'grandTotal', 'from', 'to', 'filteredStudent'        ))->setPaper('a4', 'landscape');        $pdfFilename = 'laporan-keuangan-' . $from . '-sd-' . $to . ($studentId ? '-siswa-' . $studentId : '') . '.pdf';        return $pdf->download($pdfFilename);    }    /**     * Export laporan keuangan PER SISWA (satu kartu) ke Excel     */    public function exportStudentExcel(Request $request, StudentCard $card)    {        $this->authorizeFinance('canViewFinanceCards');        $from = $request->input('from');        $to   = $request->input('to');        $studentName = $card->load('student')->student->nama_lengkap ?? 'siswa';        $safeName    = str_replace(' ', '-', strtolower($studentName));        $filename    = 'keuangan-' . $safeName . ($from ? '-' . $from . '-sd-' . $to : '') . '.xlsx';        return Excel::download(new FinanceStudentExport($card->id, $from, $to), $filename);    }    /**     * Export laporan keuangan PER SISWA (satu kartu) ke PDF     */    public function exportStudentPdf(Request $request, StudentCard $card)    {        $this->authorizeFinance('canViewFinanceCards');        $from = $request->input('from');        $to   = $request->input('to');        $card->load(['student', 'transactions.performedBy']);        $transQuery = $card->transactions()->with('performedBy');        if ($from && $to) {            $transQuery->whereBetween(DB::raw('DATE(created_at)'), [$from, $to]);        }        $transactions = $transQuery->latest()->get();        $studentName = $card->student->nama_lengkap ?? 'siswa';        $safeName    = str_replace(' ', '-', strtolower($studentName));        $filename    = 'keuangan-' . $safeName . ($from ? '-' . $from . '-sd-' . $to : '') . '.pdf';        $pdf = Pdf::loadView('admin.finance.pdf.report-student', compact('card', 'transactions', 'from', 'to'))            ->setPaper('a4', 'landscape');        return $pdf->download($filename);    }    public function exportCardsPdf(Request $request)    {        $this->authorizeFinance('canViewFinanceCards');        $query = StudentCard::with('student.angkatanModel')->latest();        $nama = $request->input('nama');        $angkatan = $request->input('angkatan');        if ($nama) {            $query->whereHas('student', function($q) use ($nama) {                $q->where('nama_lengkap', 'LIKE', '%' . $nama . '%');            });        }        if ($angkatan) {            $query->whereHas('student.angkatanModel', function($q) use ($angkatan) {                $q->where('code', $angkatan);            });        }        $cards = $query->get();        $filename = 'daftar-kartu-' . now()->format('Y-m-d') . '.pdf';        $pdf = Pdf::loadView('admin.finance.pdf.report-cards', compact('cards', 'nama', 'angkatan'))            ->setPaper('a4', 'landscape');        return $pdf->download($filename);    }    private function authorizeFinance(string $ability)    {        $user = auth()->user();        if (!$user || !method_exists($user, $ability) || !$user->{$ability}()) {            if (request()->expectsJson() || request()->ajax()) {                abort(response()->json(['success' => false, 'message' => 'Unauthorized'], 403));            }            abort(403, 'Unauthorized');        }        return $user;    }}    public function editTransaction(StudentCardTransaction $transaction)    {        $this->authorizeFinance('canManageFinanceTransactions');        $transaction->load(['card.student', 'performedBy', 'relatedCard.student']);        return view('admin.finance.transactions.edit', compact('transaction'));    }    public function updateTransaction(Request $request, StudentCardTransaction $transaction)    {        $this->authorizeFinance('canManageFinanceTransactions');        $rules = [            'description' => 'nullable|string|max:255',        ];        if (! in_array($transaction->type, ['transfer'], true)) {            $rules['amount'] = 'required|numeric|min:1000';        }        $validated = $request->validate($rules);        if (array_key_exists('amount', $validated) && $validated['amount'] != $transaction->amount) {            if (! $this->isLatestTransaction($transaction)) {                return back()->with('error', 'Hanya transaksi terakhir dapat diubah jumlahnya.');            }            $newAmount = $validated['amount'];            if ($transaction->type === 'topup') {                $balanceAfter = $transaction->balance_before + $newAmount;                $transaction->card->balance += ($newAmount - $transaction->amount);            } elseif ($transaction->type === 'payment' || $transaction->type === 'withdraw') {                $balanceAfter = $transaction->balance_before - $newAmount;                $transaction->card->balance += ($transaction->amount - $newAmount);            } else {                return back()->with('error', 'Jenis transaksi ini tidak dapat diubah jumlahnya.');            }            $transaction->card->save();            $transaction->amount = $newAmount;            $transaction->balance_after = $balanceAfter;        }        $transaction->description = $validated['description'] ?? $transaction->description;        $transaction->save();        return redirect()->route('admin.finance.transactions.index')->with('success', 'Transaksi berhasil diperbarui.');    }    public function destroyTransaction(StudentCardTransaction $transaction)    {        $this->authorizeFinance('canManageFinanceTransactions');        if (! $this->isLatestTransaction($transaction)) {            return back()->with('error', 'Hanya transaksi terakhir pada kartu yang dapat dihapus.');        }        if ($transaction->type === 'transfer') {            return back()->with('error', 'Transaksi transfer tidak dapat dihapus melalui halaman ini.');        }        DB::transaction(function () use ($transaction) {            if ($transaction->type === 'topup') {                $transaction->card->balance -= $transaction->amount;            }            if ($transaction->type === 'payment' || $transaction->type === 'withdraw') {                $transaction->card->balance += $transaction->amount;            }            $transaction->card->save();            $transaction->delete();        });        return redirect()->route('admin.finance.transactions.index')->with('success', 'Transaksi berhasil dihapus.');    }    private function isLatestTransaction(StudentCardTransaction $transaction): bool    {        $latest = $transaction->card->transactions()->latest('id')->first();        return $latest && $latest->id === $transaction->id;    }    public function paymentHistory(Request $request)    {        $user = $this->authorizeFinance('canViewFinancePaymentHistory');        $transactions = StudentCardTransaction::with(['card.student', 'performedBy'])            ->where('type', 'payment')            ->when($request->filled('student_name'), function ($query) use ($request) {                $query->whereHas('card.student', function ($studentQuery) use ($request) {                    $studentQuery->where('nama_lengkap', 'like', '%' . $request->student_name . '%');                });            })            ->when($request->filled('date'), fn ($query) => $query->whereDate('created_at', $request->date))            ->latest();        if ($user->isBums()) {            $transactions->whereNotNull('performed_by');        }        $transactions = $transactions->paginate(20)->withQueryString();        return view('admin.finance.payment-history', compact('transactions'));    }    private function generateReferenceNumber(string $prefix): string    {        do {            $referenceNumber = $prefix . now()->format('YmdHis') . random_int(100, 999);        } while (StudentCardTransaction::where('reference_number', $referenceNumber)->exists());        return $referenceNumber;    }    // =========================================    // EXPORT METHODS    // =========================================    /**     * Export laporan keuangan SEMUA siswa ke Excel     */    public function e