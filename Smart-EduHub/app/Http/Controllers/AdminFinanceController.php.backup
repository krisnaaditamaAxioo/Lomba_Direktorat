ng());        $to   = $request->input('to', now()->toDateString());        $type = $request->input('type', 'all');        $studentId = $request->input('student_id');        $filename = 'laporan-keuangan-' . $from . '-sd-' . $to . ($studentId ? '-siswa-' . $studentId : '') . '.xlsx';        return Excel::download(new FinanceReportExport($from, $to, $type, $studentId), $filename);    }    /**     * Export laporan keuangan SEMUA siswa ke PDF     */    public function exportRekapPdf(Request $request)    {        $this->authorizeFinance('canAccessFinanceRekap');        $from = $request->input('from', now()->startOfMonth()->toDateString());        $to   = $request->input('to', now()->toDateString());        $studentId = $request->input('student_id');        $query = StudentCardTransaction::with(['card.student', 'performedBy'])            ->whereBetween(DB::raw('DATE(created_at)'), [$from, $to]);        if ($studentId) {            $query->whereHas('card', function ($cardQuery) use ($studentId) {                $cardQuery->where('student_id', $studentId);            });        }        $summary = (clone $query)            ->selectRaw('type, SUM(amount) as total, COUNT(*) as count')            ->groupBy('type')            ->get()            ->keyBy('type');        $dailySummary = (clone $query)            ->selectRaw('DATE(created_at) as transaction_date')            ->selectRaw("SUM(CASE WHEN type = 'topup' THEN amount ELSE 0 END) as total_topup")            ->selectRaw("SUM(CASE WHEN type = 'payment' THEN amount ELSE 0 END) as total_payment")            ->selectRaw("SUM(CASE WHEN type = 'transfer' THEN amount ELSE 0 END) as total_transfer")            ->selectRaw('COUNT(*) as total_transactions')            ->groupBy(DB::raw('DATE(created_at)'))            ->orderBy('transaction_date', 'asc')            ->get();        $perStudentSummaryQuery = StudentCardTransaction::with(['card.student'])            ->whereBetween(DB::raw('DATE(student_card_transactions.created_at)'), [$from, $to])            ->join('student_cards', 'student_card_transactions.card_id', '=', 'student_cards.id')            ->join('students', 'student_cards.student_id', '=', 'students.id');        if ($studentId) {            $perStudentSummaryQuery->where('students.id', $studentId);        }        $perStudentSummary = $perStudentSummaryQuery->selectRaw('students.nama_lengkap, students.nis_siswa, student_cards.card_number, student_cards.balance as current_balance')            ->selectRaw("SUM(CASE WHEN student_card_transactions.type = 'topup' THEN student_card_transactions.amount ELSE 0 END) as total_topup")            ->selectRaw("SUM(CASE WHEN student_card_transactions.type = 'payment' THEN student_card_transactions.amount ELSE 0 END) as total_payment")            ->selectRaw("SUM(CASE WHEN student_card_transactions.type = 'transfer' THEN student_card_transactions.amount ELSE 0 END) as total_transfer")            ->selectRaw('COUNT(student_card_transactions.id) as total_trx')            ->groupBy('students.nama_lengkap', 'students.nis_siswa', 'student_cards.card_number', 'student_cards.balance')            ->orderBy('students.nama_lengkap')            ->get();        $transactions = (clone $query)->with(['card.student', 'performedBy'])->latest()->get();        $grandTotal = [            'topup'    => (float) optional($summary->get('topup'))->total,            'payment'  => (float) optional($summary->get('payment'))->total,            'transfer' => (float) optional($summary->get('transfer'))->total,        ];        $filteredStudent = $studentId ? Student::find($studentId) : null;        $pdf = Pdf::loadView('admin.finance.pdf.report-all', compact(            'summary', 'dailySummary', 'perStudentSummary', 'transactions', 'grandTotal', 'from', 'to', 'filteredStudent'        ))->setPaper('a4', 'landscape');        $pdfFilename = 'laporan-keuangan-' . $from . '-sd-' . $to . ($studentId ? '-siswa-' . $studentId : '') . '.pdf';        return $pdf->download($pdfFilename);    }    /**     * Export laporan keuangan PER SISWA (satu kartu) ke Excel     */    public function exportStudentExcel(Request $request, StudentCard $card)    {        $this->authorizeFinance('canViewFinanceCards');        $from = $request->input('from');        $to   = $request->input('to');        $studentName = $card->load('student')->student->nama_lengkap ?? 'siswa';        $safeName    = str_replace(' ', '-', strtolower($studentName));        $filename    = 'keuangan-' . $safeName . ($from ? '-' . $from . '-sd-' . $to : '') . '.xlsx';        return Excel::download(new FinanceStudentExport($card->id, $from, $to), $filename);    }    /**     * Export laporan keuangan PER SISWA (satu kartu) ke PDF     */    public function exportStudentPdf(Request $request, StudentCard $card)    {        $this->authorizeFinance('canViewFinanceCards');        $from = $request->input('from');        $to   = $request->input('to');        $card->load(['student', 'transactions.performedBy']);        $transQuery = $card->transactions()->with('performedBy');        if ($from && $to) {            $transQuery->whereBetween(DB::raw('DATE(created_at)'), [$from, $to]);        }        $transactions = $transQuery->latest()->get();        $studentName = $card->student->nama_lengkap ?? 'siswa';        $safeName    = str_replace(' ', '-', strtolower($studentName));        $filename    = 'keuangan-' . $safeName . ($from ? '-' . $from . '-sd-' . $to : '') . '.pdf';        $pdf = Pdf::loadView('admin.finance.pdf.report-student', compact('card', 'transactions', 'from', 'to'))            ->setPaper('a4', 'landscape');        return $pdf->download($filename);    }    public function exportCardsPdf(Request $request)    {        $this->authorizeFinance('canViewFinanceCards');        $query = StudentCard::with('student.angkatanModel')->latest();        $nama = $request->input('nama');        $angkatan = $request->input('angkatan');        if ($nama) {            $query->whereHas('student', function($q) use ($nama) {                $q->where('nama_lengkap', 'LIKE', '%' . $nama . '%');            });        }        if ($angkatan) {            $query->whereHas('student.angkatanModel', function($q) use ($angkatan) {                $q->where('code', $angkatan);            });        }        $cards = $query->get();        $filename = 'daftar-kartu-' . now()->format('Y-m-d') . '.pdf';        $pdf = Pdf::loadView('admin.finance.pdf.report-cards', compact('cards', 'nama', 'angkatan'))            ->setPaper('a4', 'landscape');        return $pdf->download($filename);    }    private function authorizeFinance(string $ability)    {        $user = auth()->user();        if (!$user || !method_exists($user, $ability) || !$user->{$ability}()) {            if (request()->expectsJson() || request()->ajax()) {                abort(response()->json(['success' => false, 'message' => 'Unauthorized'], 403));            }            abort(403, 'Unauthorized');        }        return $user;    }}