 -= $transaction->amount;            }            if ($transaction->type === 'payment' || $transaction->type === 'withdraw') {                $transaction->card->balance += $transaction->amount;            }            $transaction->card->save();            $transaction->delete();        });        return redirect()->route('admin.finance.transactions.index')->with('success', 'Transaksi berhasil dihapus.');    }    private function isLatestTransaction(StudentCardTransaction $transaction): bool    {        $latest = $transaction->card->transactions()->latest('id')->first();        return $latest && $latest->id === $transaction->id;    }    public function paymentHistory(Request $request)    {        $user = $this->authorizeFinance('canViewFinancePaymentHistory');        $transactions = StudentCardTransaction::with(['card.student', 'performedBy'])            ->where('type', 'payment')            ->when($request->filled('student_name'), function ($query) use ($request) {                $query->whereHas('card.student', function ($studentQuery) use ($request) {                    $studentQuery->where('nama_lengkap', 'like', '%' . $request->student_name . '%');                });            })            ->when($request->filled('date'), fn ($query) => $query->whereDate('created_at', $request->date))            ->latest();        if ($user->isBums()) {            $transactions->whereNotNull('performed_by');        }        $transactions = $transactions->paginate(20)->withQueryString();        return view('admin.finance.payment-history', compact('transactions'));    }    private function generateReferenceNumber(string $prefix): string    {        do {            $referenceNumber = $prefix . now()->format('YmdHis') . random_int(100, 999);        } while (StudentCardTransaction::where('reference_number', $referenceNumber)->exists());        return $referenceNumber;    }    // =========================================    // EXPORT METHODS    // =================================